# Copy this file to .env and fill in values to switch services from MOCK to LIVE.
# Leaving these unset keeps the app fully functional in mock mode.

PORT=3000

# --- Google Calendar (real mode) ---
# Presence of GOOGLE_REFRESH_TOKEN switches calendarService.js out of mock mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- SendGrid (real mode) ---
# Presence of SENDGRID_API_KEY switches emailService.js out of mock mode.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
